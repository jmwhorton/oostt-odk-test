AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000118> <http://purl.obolibrary.org/obo/RO_0002447> "An interaction relation between x and y in which x catalyzes a reaction in which a phosphate group is added to y.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/RO_0002447> "phosphorylates")
