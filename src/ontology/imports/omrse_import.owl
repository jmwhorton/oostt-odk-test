AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/RO_0002427> "causally downstream of or within")
SubObjectPropertyOf(<http://purl.obolibrary.org/obo/RO_0002427> <http://purl.obolibrary.org/obo/RO_0002501>)
TransitiveObjectProperty(<http://purl.obolibrary.org/obo/RO_0002427>)

# Object Property: <http://purl.obolibrary.org/obo/RO_0002428> (involved in regulation of)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/RO_0002428> "c involved in regulation of p if c is involved in some p' and p' regulates some p")
AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000117> <http://purl.obolibrary.org/obo/RO_0002428> <https://orcid.org/0000-0002-6601-2165>)
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/RO_0002428> "involved in regulation of")
SubObjectPropertyOf(<http://purl.obolibrary.org/obo/RO_0002428> <http://purl.obolibrary.org/obo/RO_0002263>)
SubObjectPropertyOf(<http://purl.obolibrary.org/obo/RO_0002428> <http://purl.obolibrary.org/obo/RO_0002431>)

# Object Property: <http://purl.obolibrary.org/obo/RO_0002429> (involved in positive regulation of)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/RO_0002429> "c involved in regulation of p if c is involved in some p' and p' positively regulates some p")
AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000117> <http://purl.obolibrary.org/obo/RO_0002429> <https://orcid.org/0000-0002-6601-2165>)
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/RO_0002429> "involved in positive regulation of")
