SubClassOf(<http://purl.obolibrary.org/obo/OMRSE_00000139> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000054> <http://purl.obolibrary.org/obo/OAE_0000067>))

