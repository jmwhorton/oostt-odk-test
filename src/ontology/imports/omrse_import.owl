AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/OMRSE_00002072> "role in human social processes"@en)
SubClassOf(<http://purl.obolibrary.org/obo/OMRSE_00002072> <http://purl.obolibrary.org/obo/BFO_0000023>)
SubClassOf(<http://purl.obolibrary.org/obo/OMRSE_00002072> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/RO_0000052> <http://purl.obolibrary.org/obo/BFO_0000040>))
SubClassOf(<http://purl.obolibrary.org/obo/OMRSE_00002072> ObjectAllValuesFrom(<http://purl.obolibrary.org/obo/RO_0000052> <http://purl.obolibrary.org/obo/BFO_0000040>))

# Class: <http://purl.obolibrary.org/obo/OOSTT_00000074> (academic degree)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/OOSTT_00000074> "An information content entity that is the specified outcome of and documents the sucessful completion of a tertiary education program."@en)
AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000117> <http://purl.obolibrary.org/obo/OOSTT_00000074> "John Judkins"@en)
AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000117> <http://purl.obolibrary.org/obo/OOSTT_00000074> "Mathias Brochhausen"@en)
AnnotationAssertion(<http://purl.obolibrary.org/obo/OOSTT_00000030> <http://purl.obolibrary.org/obo/OOSTT_00000074> "Recognized degree awarded after successful completion of a college or post-graduate porgram."@en)
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/OOSTT_00000074> "academic degree"@en)
SubClassOf(<http://purl.obolibrary.org/obo/OOSTT_00000074> <http://purl.obolibrary.org/obo/IAO_0000030>)

# Class: <http://purl.obolibrary.org/obo/OOSTT_00000081> (associate degree)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/OOSTT_00000081> "An academic degree awarded by colleges and universities upon completion of a program of study lasting two years."@en)
AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000117> <http://purl.obolibrary.org/obo/OOSTT_00000081> "John Judkins"@en)
AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000117> <http://purl.obolibrary.org/obo/OOSTT_00000081> "Mathias Brochhausen"@en)
AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000119> <http://purl.obolibrary.org/obo/OOSTT_00000081> "https://en.wikipedia.org/w/index.php?title=Associate_degree&oldid=723897149"@en)
AnnotationAssertion(<http://purl.obolibrary.org/obo/OOSTT_00000030> <http://purl.obolibrary.org/obo/OOSTT_00000081> "Recognition awarded after completion of a specific curriculum from an accredited tertiary education provider that falls between high school and bachelor's degree program."@en)
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/OOSTT_00000081> "associate degree"@en)
SubClassOf(<http://purl.obolibrary.org/obo/OOSTT_00000081> <http://purl.obolibrary.org/obo/OOSTT_00000074>)

# Class: <http://purl.obolibrary.org/obo/OOSTT_00000082> (master's degree)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/OOSTT_00000082> "An academic degree awarded by universities upon completion of a course of study demonstrating a mastery or high-order overview of a specific field of study or area of professional practice.[1] Within the area studied, graduates are posited to possess advanced knowledge of a specialized body of theoretical and applied topics; high order skills in analysis, critical evaluation, or professional application; and the ability to solve complex problems and think rigorously and independently."@en)
AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000117> <http://purl.obolibrary.org/obo/OOSTT_00000082> "John Judkins"@en)
AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000117> <http://purl.obolibrary.org/obo/OOSTT_00000082> "Mathias Brochhausen"@en)
AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000119> <http://purl.obolibrary.org/obo/OOSTT_00000082> "https://en.wikipedia.org/w/index.php?title=Master%27s_degree&oldid=726036185"@en)
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/OOSTT_00000082> "master's degree"@en)
SubClassOf(<http://purl.obolibrary.org/obo/OOSTT_00000082> <http://purl.obolibrary.org/obo/OOSTT_00000074>)

# Class: <http://purl.obolibrary.org/obo/OOSTT_00000083> (bachelor's degree)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/OOSTT_00000083> "An academic degree awarded by colleges and universities upon completion of a course of study lasting three to seven years."@en)
AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000117> <http://purl.obolibrary.org/obo/OOSTT_00000083> "John Judkins"@en)
AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000117> <http://purl.obolibrary.org/obo/OOSTT_00000083> "Mathias Brochhausen"@en)
AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000119> <http://purl.obolibrary.org/obo/OOSTT_00000083> "https://en.wikipedia.org/w/index.php?title=Bachelor%27s_degree&oldid=725713923"@en)
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/OOSTT_00000083> "bachelor's degree"@en)
SubClassOf(<http://purl.obolibrary.org/obo/OOSTT_00000083> <http://purl.obolibrary.org/obo/OOSTT_00000074>)

# Class: <http://purl.obolibrary.org/obo/OOSTT_00000084> (bachelor's of nursing degree)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/OOSTT_00000084> "An academic degree in the science and principles of nursing, granted by an accredited tertiary education provider after the successful completion of a bachelor's of nursing program."@en)
AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000117> <http://purl.obolibrary.org/obo/OOSTT_00000084> "John Judkins"@en)
AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000117> <http://purl.obolibrary.org/obo/OOSTT_00000084> "Mathias Brochhausen"@en)
AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000119> <http://purl.obolibrary.org/obo/OOSTT_00000084> "https://en.wikipedia.org/w/index.php?title=Bachelor_of_Science_in_Nursing&oldid=725962822"@en)
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/OOSTT_00000084> "bachelor's of nursing degree"@en)
SubClassOf(<http://purl.obolibrary.org/obo/OOSTT_00000084> <http://purl.obolibrary.org/obo/OOSTT_00000083>)

# Class: <http://purl.obolibrary.org/obo/OOSTT_00000086> (master's in the science of nursing degree)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/OOSTT_00000086> "An academic degree in the science and principles of nursing, granted by an accredited tertiary education provider after the successful completion of a master's of nursing program."@en)
AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000117> <http://purl.obolibrary.org/obo/OOSTT_00000086> "John Judkins"@en)
AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000117> <http://purl.obolibrary.org/obo/OOSTT_00000086> "Mathias Brochhausen"@en)
AnnotationAssertion(<http://purl.obolibrary.org/obo/OOSTT_00000030> <http://purl.obolibrary.org/obo/OOSTT_00000086> "An advanced academic degree in the principles and practices of nursing, with a focus on administration, education, or advanced nursing practice, granted by an accredited college or university after the successful completion of a master's of nursing program."@en)
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/OOSTT_00000086> "master's in the science of nursing degree"@en)
SubClassOf(<http://purl.obolibrary.org/obo/OOSTT_00000086> <http://purl.obolibrary.org/obo/OOSTT_00000082>)

# Class: <http://purl.obolibrary.org/obo/OOSTT_00000090> (orthopedic surgeon role)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/OOSTT_00000090> "A surgeon role borne by a human being and, that, if realized, is realized by its bearer using operative manual or instrumental techniques on the musculoskeletal system of a patient to investigate or treat a pathological condition such as disease or injury, to help improve bodily function or appearance or to repair unwanted ruptured areas."@en)
AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000117> <http://purl.obolibrary.org/obo/OOSTT_00000090> "Mathias Brochhausen"@en)
AnnotationAssertion(<http://purl.obolibrary.org/obo/OOSTT_00000030> <http://purl.obolibrary.org/obo/OOSTT_00000090> "A surgeon who specializes in performing operative manual and instrumental techniques on the musculoskeletal system of a patient to investigate or treat a pathological condition such as disease or injury, to help improve bodily function or appearance or to repair ruptured areas."@en)
AnnotationAssertion(rdfs:isDefinedBy <http://purl.obolibrary.org/obo/OOSTT_00000090> <http://purl.obolibrary.org/obo/omrse.owl>)
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/OOSTT_00000090> "orthopedic surgeon role"@en)
SubClassOf(<http://purl.obolibrary.org/obo/OOSTT_00000090> <http://purl.obolibrary.org/obo/OMRSE_00000139>)

# Class: <http://purl.obolibrary.org/obo/OOSTT_00000096> (trauma surgeon role)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/OOSTT_00000096> "A surgeon role borne by a human being and, that, if realized, is realized by its bearer using operative and non-operative manual or instrumental techniques on a patient to investigate or treat an injury or other pathological situation that are caused by an injury, to help improve bodily function or appearance or to repair unwanted ruptured areas."@en)
AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000117> <http://purl.obolibrary.org/obo/OOSTT_00000096> "Mathias Brochhausen"@en)
AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000117> <http://purl.obolibrary.org/obo/OOSTT_00000096> "Sarah Bost"@en)
AnnotationAssertion(<http://purl.obolibrary.org/obo/OOSTT_00000030> <http://purl.obolibrary.org/obo/OOSTT_00000096> "A surgeon with oversight responsibility for the emergent, urgent, and restorative care of the injured patient, who specializes in performing operative and non-operative manual and instrumental techniques on a patient to investigate or treat an injury to help improve bodily function or appearance, or to repair ruptured areas."@en)
AnnotationAssertion(rdfs:isDefinedBy <http://purl.obolibrary.org/obo/OOSTT_00000096> <http://purl.obolibrary.org/obo/omrse.owl>)
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/OOSTT_00000096> "trauma surgeon role"@en)
SubClassOf(<http://purl.obolibrary.org/obo/OOSTT_00000096> <http://purl.obolibrary.org/obo/OMRSE_00000139>)

# Class: <http://purl.obolibrary.org/obo/OOSTT_00000153> (emergency physician role)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/OOSTT_00000153> "A physician role that, if it is realized, is realized by providing treatment for undifferentiated and unscheduled  patients with illnesses and injuries requiring immediate medical attention."@en)
AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000117> <http://purl.obolibrary.org/obo/OOSTT_00000153> "Mathias Brochhausen"@en)
AnnotationAssertion(<http://purl.obolibrary.org/obo/OOSTT_00000030> <http://purl.obolibrary.org/obo/OOSTT_00000153> "A physician who  provides treatment to the ill and injured needing urgent and emergent care."@en)
AnnotationAssertion(rdfs:isDefinedBy <http://purl.obolibrary.org/obo/OOSTT_00000153> <http://purl.obolibrary.org/obo/omrse.owl>)
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/OOSTT_00000153> "emergency physician role"@en)
SubClassOf(<http://purl.obolibrary.org/obo/OOSTT_00000153> <http://purl.obolibrary.org/obo/OMRSE_00000013>)

# Class: <http://purl.obolibrary.org/obo/OOSTT_00000195> (general surgeon role)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/OOSTT_00000195> "A surgeon role borne by a human being and that, if realized, is being realized by its bearer using operative manual and instrumental techniques on a patient to investigate or treat a pathological condition such as disease or injury, to help improve bodily function or appearance or to repair unwanted ruptured areas without the bearer of the role specializing into any particular field of surgery."@en)
AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000117> <http://purl.obolibrary.org/obo/OOSTT_00000195> "Mathias Brochhausen"@en)
AnnotationAssertion(<http://purl.obolibrary.org/obo/OOSTT_00000030> <http://purl.obolibrary.org/obo/OOSTT_00000195> "A surgeon without specialization who performs operative manual and instrumental techniques on a patient to investigate or treat a  disease or injury, to help improve bodily function or appearance, or to repair unwanted ruptured areas ."@en)
AnnotationAssertion(rdfs:isDefinedBy <http://purl.obolibrary.org/obo/OOSTT_00000195> <http://purl.obolibrary.org/obo/omrse.owl>)
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/OOSTT_00000195> "general surgeon role"@en)
